  "entrypoints": {
    "main": [
      "com.yuushya.fabric.YuushyaFabric"
    ],
    "client": [
      "com.yuushya.fabric.YuushyaClientFabric"
    ]
  },
  "mixins": [
    "yuushya.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
