{
  "schemaVersion": 1,
  "id": "yuushya",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_source}"
  },
  "license": "${mod_licence}",
  "icon": "pack.png",
